<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found | WuiWuiCafe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body.error-page {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 90vh; 
            padding: 20px;
            box-sizing: border-box;
        }
        .auth-container.error-container {
             margin: 0;
        }
    </style>
</head>
<body class="error-page">

    <div class="hero auth-container error-container" style="max-width: 500px;">
        <h1 style="color: var(--accent); font-size: 5rem; margin: 0; line-height: 1;">404</h1>
        <h2 style="color: var(--text-dark); margin-top: 10px;">Oops! Page Not Found</h2>
        
        <p style="margin-bottom: 25px;">It seems this page was knocked off the table by a cat.</p>
        
        <div style="margin: 0 auto 30px; width: 100%; max-width: 350px; border-radius: 20px; overflow: hidden; border: 4px solid var(--primary-pink); box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
            <img src="/images/404.jpg" alt="Confused Cat" style="width: 100%; display: block; height: auto;">
        </div>

        <a href="/" class="btn primary" style="width: 100%; box-sizing: border-box;">Return to Home</a>
    </div>

    </body>
</html>