<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | WuiWuiCafe</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>    
    <nav>
        <div class="logo">WuiWuiCafe</div>
        <div class="nav-links">
            <a href="/" class="active"><%= __("nav_home") %></a>
            <a href="/cats"><%= __("nav_cats") %></a>
            <a href="/games"><%= __("nav_games") %></a>
            
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-menu">
                    <span class="user-name"><%= user.username %></span>
                    <a href="/logout" class="btn-logout"><%= __("nav_logout") %></a>
                </div>
            <% } else { %>
                <a href="/login"><%= __("nav_login") %></a>
                <a href="/register" class="btn-signup"><%= __("nav_signup") %></a>
            <% } %>

            <div class="lang-switcher">
                <a href="/change-lang/en" class="<%= locale === 'en' ? 'lang-active' : '' %>">EN</a>
                <span>|</span>
                <a href="/change-lang/lv" class="<%= locale === 'lv' ? 'lang-active' : '' %>">LV</a>
            </div>

            <div class="accessibility-toggle-container">
                <label class="switch">
                    <input type="checkbox" id="accessibility-checkbox" onclick="toggleAccessibility()">
                    <span class="slider-toggle"></span>
                </label>
            </div>
        </div>
    </nav>

    <h1 class="main-welcome"><%= __("welcome_title") %> <span class="highlight">WuiWuiCafe</span></h1>

    <section class="about-strip">
        <div class="about-container">
            <div class="about-text">
                <h2><%= __("about_title") %></h2>
                <p><%= __("about_text") %></p>
            </div>
            <div class="about-action">
                <a href="/cats" class="btn primary"><%= __("btn_meet_residents") %></a>
            </div>
        </div>
    </section>

    <section class="quiz-strip">
        <div class="quiz-container">
            <h2><%= __("quiz_title") %></h2>
            <p><%= __("quiz_subtitle") %></p>
            
            <button id="start-quiz-btn" class="btn primary" onclick="startQuiz()"><%= __("quiz_btn") %></button>

            <div id="quiz-box" class="hidden">
                <h3 id="question-text"><%= __("quiz_q_placeholder") %></h3>
                <div class="options-grid">
                    <button class="quiz-option" onclick="answer(0)"><%= __("quiz_opt_a") %></button>
                    <button class="quiz-option" onclick="answer(1)"><%= __("quiz_opt_b") %></button>
                    <button class="quiz-option" onclick="answer(2)"><%= __("quiz_opt_c") %></button>
                </div>
            </div>

            <div id="result-box" class="hidden">
                <h3><%= __("quiz_res_intro") %></h3>
                <h2 id="result-title" class="highlight">RESULT NAME</h2>
                <div class="result-img-wrapper">
                    <img id="result-img" src="" alt="Cat Result">
                </div>
                <p id="result-desc"><%= __("quiz_res_desc") %></p>
                <button class="btn-refresh" onclick="location.reload()"><%= __("quiz_try_again") %></button>
            </div>
        </div>
    </section>

    <section class="api-container">
        <div class="api-header">
            <h3><%= __("mood_title") %></h3>
            <p><%= __("mood_desc") %></p>
            <small><%= __("mood_powered") %></small>
        </div>

        <div class="random-grid">
            <% if (locals.apiCats && apiCats.length > 0) { %>
                <% apiCats.forEach(function(cat) { %>
                    <div class="random-card">
                        <img src="<%= cat.url %>" alt="Random Cat from Internet">
                    </div>
                <% }); %>
            <% } else { %>
                <p><%= __("mood_error") %></p>
            <% } %>
        </div>
        
        <div style="text-align: center; margin-top: 30px;">
            <a href="/" class="btn-refresh"><%= __("mood_btn") %></a>
        </div>
    </section>

    <footer>
        <p><%= __("footer_copy") %></p>
    </footer>

    <script>
        window.quizData = {
            questions: [
                {
                    q: "<%= __('q1') %>",
                    options: ["<%= __('q1_opt1') %>", "<%= __('q1_opt2') %>", "<%= __('q1_opt3') %>"],
                    scores: [0, 1, 2]
                },
                {
                    q: "<%= __('q2') %>",
                    options: ["<%= __('q2_opt1') %>", "<%= __('q2_opt2') %>", "<%= __('q2_opt3') %>"],
                    scores: [3, 0, 2]
                },
                {
                    q: "<%= __('q3') %>",
                    options: ["<%= __('q3_opt1') %>", "<%= __('q3_opt2') %>", "<%= __('q3_opt3') %>"],
                    scores: [0, 1, 3]
                }
            ],
            results: {
                0: { name: "<%= __('res_0_name') %>", desc: "<%= __('res_0_desc') %>", img: "/images/quiz/cat_sleepy.jpg" },
                1: { name: "<%= __('res_1_name') %>", desc: "<%= __('res_1_desc') %>", img: "/images/quiz/cat_silly.jpg" },
                2: { name: "<%= __('res_2_name') %>", desc: "<%= __('res_2_desc') %>", img: "/images/quiz/cat_hungry.jpg" },
                3: { name: "<%= __('res_3_name') %>", desc: "<%= __('res_3_desc') %>", img: "/images/quiz/cat_grumpy.jpg" }
            }
        };
    </script>

    <script src="/js/quiz.js"></script>

    <script>
        function toggleAccessibility() {
            const checkbox = document.getElementById('accessibility-checkbox');
            if (checkbox.checked) {
                document.body.classList.add('accessibility-mode');
                localStorage.setItem('accessibilityMode', 'enabled');
            } else {
                document.body.classList.remove('accessibility-mode');
                localStorage.setItem('accessibilityMode', 'disabled');
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const checkbox = document.getElementById('accessibility-checkbox');
            if (localStorage.getItem('accessibilityMode') === 'enabled') {
                document.body.classList.add('accessibility-mode');
                if (checkbox) checkbox.checked = true;
            }
        });
    </script>
</body>
</html>