<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Cats | WuiWuiCafe</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="logo">WuiWuiCafe</div>
        
        <button class="menu-toggle" aria-label="Toggle navigation" onclick="toggleMenu()">
            <span class="hamburger"></span>
        </button>

        <div class="nav-links" id="navLinks">
            <a href="/"><%= __("nav_home") %></a>
            <a href="/cats" class="active"><%= __("nav_cats") %></a>
            <a href="/games"><%= __("nav_games") %></a>
            
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-menu mobile-user-menu">
                    <span class="user-name"><%= user.username %></span>
                    <a href="/logout" class="btn-logout"><%= __("nav_logout") %></a>
                </div>
            <% } else { %>
                <a href="/login"><%= __("nav_login") %></a>
                <a href="/register" class="btn-signup"><%= __("nav_signup") %></a>
            <% } %>

            <div class="lang-switcher">
                <a href="/change-lang/en" class="<%= locale === 'en' ? 'lang-active' : '' %>">EN</a>
                <span>|</span>
                <a href="/change-lang/lv" class="<%= locale === 'lv' ? 'lang-active' : '' %>">LV</a>
            </div>

            <div class="accessibility-toggle-container">
                <label class="switch">
                    <input type="checkbox" id="accessibility-checkbox" onclick="toggleAccessibility()">
                    <span class="slider-toggle"></span>
                </label>
            </div>
        </div>
    </nav>
    <header class="page-header">
        <h1><%= __("cats_stars_title") %></h1>
        <p><%= __("cats_stars_sub") %></p>
    </header>

    <main class="cats-container">
        <h2 class="visually-hidden" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;"><%= __("cats_list_hidden") %></h2>
        
        <% cats.forEach(function(cat, index) { %>
            <section class="cat-section" id="cat-<%= index %>">
                
                <div class="cat-visual">
                    <div class="slider-wrapper">
                        <button class="slider-btn prev" onclick="moveSlide('<%= index %>', -1)">&#10094;</button>
                        
                        <div class="slides-container" id="slides-<%= index %>">
                            <% cat.images.forEach(function(img, imgIndex) { %>
                                <img src="<%= img %>" class="slide-img <%= imgIndex === 0 ? 'active' : '' %>" alt="Photo of <%= cat.name %> - image <%= imgIndex + 1 %>">
                            <% }); %>
                        </div>

                        <button class="slider-btn next" onclick="moveSlide('<%= index %>', 1)">&#10095;</button>
                    </div>
                </div>

                <div class="cat-details">
                    <div class="details-content">
                        <h2><%= cat.name %> <span class="age-tag"><%= __("cat_age_" + cat.name.toLowerCase()) %></span></h2>
                        <p><%= __("cat_desc_" + cat.name.toLowerCase()) %></p>
                        
                        <button class="btn-like" onclick="toggleLike(this, '<%= cat.name %>')">
                            <span class="heart-icon">❤</span> 
                            <span class="like-text"><%= __("cat_like") %> <%= cat.name %></span>
                        </button>
                    </div>
                </div>

            </section>
        <% }); %>

    </main>

    <footer>
        <p><%= __("footer_copy") %></p>
    </footer>

    <script>
        function moveSlide(catIndex, direction) {
            const container = document.getElementById(`slides-${catIndex}`);
            const slides = container.getElementsByClassName('slide-img');
            
            let activeIndex = 0;
            for (let i = 0; i < slides.length; i++) {
                if (slides[i].classList.contains('active')) {
                    activeIndex = i;
                    slides[i].classList.remove('active');
                    break;
                }
            }

            let newIndex = activeIndex + direction;
            if (newIndex >= slides.length) newIndex = 0;
            if (newIndex < 0) newIndex = slides.length - 1;

            slides[newIndex].classList.add('active');
        }

        function toggleLike(btn, catName) {
            btn.classList.toggle('liked');
            const textSpan = btn.querySelector('.like-text');
            const heartSpan = btn.querySelector('.heart-icon');

            if (btn.classList.contains('liked')) {
                textSpan.innerText = "<%= __('cat_liked') %>";
                heartSpan.innerText = "💖";
            } else {
                textSpan.innerText = "<%= __('cat_like') %> " + catName;
                heartSpan.innerText = "❤";
            }
        }

        function toggleAccessibility() {
            const checkbox = document.getElementById('accessibility-checkbox');
            if (checkbox.checked) {
                document.body.classList.add('accessibility-mode');
                localStorage.setItem('accessibilityMode', 'enabled');
            } else {
                document.body.classList.remove('accessibility-mode');
                localStorage.setItem('accessibilityMode', 'disabled');
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const checkbox = document.getElementById('accessibility-checkbox');
            if (localStorage.getItem('accessibilityMode') === 'enabled') {
                document.body.classList.add('accessibility-mode');
                if (checkbox) checkbox.checked = true;
            }
        });
    </script>
    <script>
        function toggleMenu() {
            const navLinks = document.getElementById('navLinks');
            const menuToggle = document.querySelector('.menu-toggle');
            navLinks.classList.toggle('open');
            menuToggle.classList.toggle('open');
        }
    </script>
</body>
</html>
