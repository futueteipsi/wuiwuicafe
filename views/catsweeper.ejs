<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CatSweeper | WuiWuiCafe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* centering the game */
        .game-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 20px;
            position: relative;
        }

        .center-text {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .instructions {
            background: rgba(255, 255, 255, 0.6);
            padding: 10px 20px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 10px;
            font-weight: bold;
            color: var(--text-dark);
            font-size: 0.9rem;
            border: 1px solid var(--primary-pink);
        }

        .minesweeper-container {
            background: #fff0f5;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(255, 183, 197, 0.4);
            border: 4px solid var(--primary-pink);
            position: relative;
        }
        
        /* counter */
        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8bbd0;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 15px;
            border: 2px solid #f48fb1;
        }

        .counter {
            background: #ad1457;
            color: #ff80ab;
            font-family: 'Courier New', monospace;
            font-size: 24px;
            padding: 5px 10px;
            border-radius: 5px;
            min-width: 50px;
            font-weight: bold;
        }

        .reset-btn {
            width: 40px;
            height: 40px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            transition: transform 0.2s;
        }
        .reset-btn:hover { transform: scale(1.1); }
        .reset-btn img { width: 100%; height: 100%; }

        .grid {
            display: grid;
            grid-template-columns: repeat(9, 32px);
            gap: 0;
            border: 4px solid #8d6e63;
            margin: 0 auto;
        }

        .cell {
            width: 32px;
            height: 32px;
            cursor: pointer;
        }
        .cell img { width: 100%; height: 100%; display: block; }

        /* modal window */
        .modal-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255, 255, 255, 0.9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border-radius: 16px;
            z-index: 10;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal-content {
            background: white;
            padding: 20px 40px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            border: 3px solid var(--accent);
        }

        .modal-content h2 { margin-top: 0; color: var(--accent); }
        
        /* buttons in m window */
        .modal-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 15px;
        }

        .btn-restart {
            background: var(--accent);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
            font-size: 1rem;
            text-decoration: none;
        }
        .btn-restart:hover { background: var(--deep-pink); }

        .btn-exit {
            background: white;
            color: var(--accent);
            border: 2px solid var(--accent);
            padding: 8px 18px;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
            font-size: 1rem;
            text-decoration: none;
        }
        .btn-exit:hover { background: #fff0f5; }

    </style>
</head>
<body>
    <nav>
        <div class="logo">WuiWuiCafe</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/cats">Our Cats</a>
            <a href="/games" class="active">Games</a>
            <div class="user-menu">
                <span class="user-name"><%= user.username %></span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="hero center-text">
        <h1>CatSweeper</h1>
        <p>Find all safe spots without touching a bomb!</p>
        
        <div class="instructions">
            Left Click: Open Cell &nbsp;|&nbsp; Right Click: Place Flag
        </div>

        <div class="game-wrapper">
            <div class="minesweeper-container">
                
                <div class="game-header">
                    <div class="counter" id="bomb-count">010</div>
                    <button class="reset-btn" onclick="initGame()">
                        <img src="/images/minesweeper/face_happy.png" id="face-btn" alt="Reset">
                    </button>
                    <div class="counter" id="timer">000</div>
                </div>

                <div class="grid" id="grid"></div>

                <div class="modal-overlay" id="game-modal">
                    <div class="modal-content">
                        <h2 id="modal-title">You Won!</h2>
                        <p id="modal-text">All safe spots found!</p>
                        
                        <div class="modal-buttons">
                            <button class="btn-restart" onclick="initGame()">Play Again</button>
                            <a href="/games" class="btn-exit">Exit to Menu</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        
        <br>
        <a href="/games" style="color: var(--text-dark); text-decoration: underline;">← Back to Games</a>
    </div>

    <script src="/js/minesweeper.js"></script>
</body>
</html>