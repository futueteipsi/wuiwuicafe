<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Game Zone | WuiWuiCafe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .center-content {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
    </style>
</head>
<body>
    <nav>
        <div class="logo">WuiWuiCafe</div>
        <button class="burger-menu" onclick="toggleMenu()">
            <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="nav-links">
            <button class="close-menu" onclick="toggleMenu()">&times;</button>
            <a href="/" class="<%= (typeof page !== 'undefined' && page === 'home') ? 'active' : '' %>"><%= __("nav_home") %></a>
            <a href="/cats" class="<%= (typeof page !== 'undefined' && page === 'cats') ? 'active' : '' %>"><%= __("nav_cats") %></a>
            <a href="/games" class="<%= (typeof page !== 'undefined' && page === 'games') ? 'active' : '' %>"><%= __("nav_games") %></a>
            
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="user-menu">
                    <span class="user-name"><%= user.username %></span>
                    <a href="/logout" class="btn-logout"><%= __("nav_logout") %></a>
                </div>
            <% } else { %>
                <a href="/login"><%= __("nav_login") %></a>
                <a href="/register" class="btn-signup"><%= __("nav_signup") %></a>
            <% } %>
    
            <div class="lang-switcher">
                <a href="/change-lang/en" class="<%= locale === 'en' ? 'lang-active' : '' %>">EN</a>
                <span>|</span>
                <a href="/change-lang/lv" class="<%= locale === 'lv' ? 'lang-active' : '' %>">LV</a>
            </div>
        </div>
    </nav>
    <script>
        function toggleMenu() { document.getElementById('nav-links').classList.toggle('show'); }
    </script>

    <div class="hero center-content">
        <h1><%= __("game_zone_title") %></h1>
        <p><%= __("game_zone_subtitle") %></p>

        <div class="games-grid">
            
            <div class="game-card">
                <h2>CatSweeper</h2>
                <p><%= __("game_desc_catsweeper") %></p>
                <br>
                <a href="/games/catsweeper" class="btn primary"><%= __("game_play_now") %></a>
            </div>

            <div class="game-card locked">
                <h2>Memory Cat</h2>
                <p><%= __("game_desc_memory") %> <br>(<%= __("game_coming_soon") %>)</p>
                <br>
                <button class="btn" disabled style="background: #ccc; cursor: not-allowed;"><%= __("game_locked") %></button>
            </div>

        </div>
    </div>
    
    <script>
        function toggleAccessibility() {
            const checkbox = document.getElementById('accessibility-checkbox');
            if (checkbox.checked) {
                document.body.classList.add('accessibility-mode');
                localStorage.setItem('accessibilityMode', 'enabled');
            } else {
                document.body.classList.remove('accessibility-mode');
                localStorage.setItem('accessibilityMode', 'disabled');
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            const checkbox = document.getElementById('accessibility-checkbox');
            if (localStorage.getItem('accessibilityMode') === 'enabled') {
                document.body.classList.add('accessibility-mode');
                if (checkbox) checkbox.checked = true;
            }
        });
    </script>
</body>
</html>
