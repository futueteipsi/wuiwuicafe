<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Game Zone | WuiWuiCafe</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* centering */
        .center-content {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
    </style>
</head>
<body>
    <nav>
        <div class="logo">WuiWuiCafe</div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/cats">Our Cats</a>
            <a href="/games" class="active">Games</a>
            <div class="user-menu">
                <span class="user-name"><%= user.username %></span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </div>
    </nav>

    <div class="hero center-content">
        <h1>Game Zone</h1>
        <p>Choose your game and set a high score!</p>

        <div class="games-grid" style="display: flex; justify-content: center; gap: 30px; margin-top: 40px; flex-wrap: wrap;">
            
            <div class="game-card" style="background: white; padding: 20px; border-radius: 20px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); max-width: 300px;">
                <h3 style="color: var(--accent); margin-top: 0;">CatSweeper</h3>
                <p>Classic minesweeper but cuter. Find all safe spots without touching a bomb.</p>
                <br>
                <a href="/games/catsweeper" class="btn primary">Play Now</a>
            </div>

            <div class="game-card" style="background: white; padding: 20px; border-radius: 20px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); max-width: 300px; opacity: 0.7;">
                <h3 style="color: gray; margin-top: 0;">Memory Cat</h3>
                <p>Find matching pairs. <br>(Coming Soon)</p>
                <br>
                <button class="btn" disabled style="background: #ccc; cursor: not-allowed;">Locked</button>
            </div>

        </div>
    </div>
</body>
</html>